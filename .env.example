# =============================================================================
# Environment Configuration Template
# =============================================================================
# This file documents all configurable environment variables for the
# security-hardened hello_world server. Copy this file to .env and update
# values for your environment. Do NOT commit .env files containing real secrets.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your environment-specific values
#   node server.js
#
# All variables have sensible defaults. The server will start with HTTP on
# 127.0.0.1:3000 if no environment variables are set.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port number the server listens on.
# Default: 3000
PORT=3000

# Host address the server binds to.
# Use 127.0.0.1 (loopback) for local-only access.
# Use 0.0.0.0 to accept connections on all network interfaces.
# Default: 127.0.0.1
HOST=127.0.0.1

# Node environment (development, production, test).
# Affects security header strictness and error verbosity.
# Default: development
NODE_ENV=development

# -----------------------------------------------------------------------------
# TLS/HTTPS Configuration
# -----------------------------------------------------------------------------
# HTTPS mode is optional. The server runs HTTP by default.
# To enable HTTPS, provide paths to both a TLS private key and certificate.
# If either variable is unset or the files are not found, the server falls
# back to HTTP automatically.
#
# For development, generate self-signed certificates:
#   ./scripts/generate-cert.sh
#
# For production, use certificates issued by a trusted Certificate Authority.

# Absolute or relative path to the TLS private key file (PEM format).
# Default: (unset — HTTP mode)
SSL_KEY_PATH=./certs/key.pem

# Absolute or relative path to the TLS certificate file (PEM format).
# Default: (unset — HTTP mode)
SSL_CERT_PATH=./certs/cert.pem

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Controls which origins are allowed to make cross-origin requests to this
# server. The cors middleware will set Access-Control-Allow-Origin and related
# headers based on this value.

# Allowed CORS origin. Set to the origin of your front-end application.
# Use a comma-separated list for multiple origins if supported by your
# cors middleware configuration.
# Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Protects the server from abuse and denial-of-service attacks by limiting
# the number of requests each IP address can make within a sliding time window.
# Clients exceeding the limit receive HTTP 429 (Too Many Requests).

# Duration of the rate limit window in minutes.
# Default: 15
RATE_LIMIT_WINDOW=15

# Maximum number of requests allowed per IP address within the window.
# Default: 100
RATE_LIMIT_MAX=100
